# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL (primary transactional data) ───────────────────────────────
DATABASE_URL="postgresql://ntrack:ntrack_local@localhost:5432/ntrack_app?schema=public&connection_limit=10"

# ── Redis (config snapshots, click stream, queues, rate limits) ───────────
REDIS_URL=redis://localhost:6379

# ── ClickHouse (click and event analytics) ────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=ntrack
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=4000
# Origin of the console (the Nextagmedia site). Used for CORS and cookie checks.
CONSOLE_ORIGIN=http://localhost:3000
# Cookie settings. In production COOKIE_SECURE must be true.
COOKIE_SECURE=false
# Set to /ntrack in production so the cookie is only sent to the console and its API proxy.
COOKIE_PATH=/
SESSION_TTL_HOURS=12
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY encrypts MFA secrets, publisher tax/payment details and integration credentials.
ENCRYPTION_KEY=
# Keys the HMACs used for IP hashing and visitor fingerprints. Shared with the tracker.
TRACKING_HASH_SECRET=

# Development only: allow postbacks to localhost/private IPs (refused in production).
ALLOW_PRIVATE_OUTBOUND=false

# ── Tracker ───────────────────────────────────────────────────────────────
TRACKER_PORT=4100
# Hostname customers point their tracking domains at (CNAME target).
TRACKER_CNAME_TARGET=edge.ntrack.nextagmedia.com
# Trust X-Forwarded-For / CF-Connecting-IP only behind a known proxy (Cloudflare / load balancer).
TRUST_PROXY=false
# Development only: serve requests whose Host header is not a registered domain as this hostname.
TRACKER_DEV_HOST_OVERRIDE=

# ── Seed (first super admin; only used by `npm run seed -w @ntrack/api`) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="NTrack Admin"

# ── Email (notifications, scheduled reports). Leave empty to keep email off. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Path of the console on CONSOLE_ORIGIN (empty if the console has its own domain). Used in email links.
CONSOLE_BASE_PATH=/ntrack

# Privacy export archives (local disk in development; shared private storage in production).
DATA_EXPORT_DIR=.local/exports
DATA_EXPORT_TTL_DAYS=7
