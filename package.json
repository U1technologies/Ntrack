{
  "name": "ntrack-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NTrack by Nextagmedia: affiliate tracking and performance marketing platform (API, tracker, workers)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @ntrack/api",
    "dev:tracker": "npm run dev -w @ntrack/tracker",
    "dev:workers": "npm run dev -w @ntrack/workers",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @ntrack/db",
    "db:migrate": "npm run migrate:dev -w @ntrack/db",
    "db:deploy": "npm run migrate:deploy -w @ntrack/db",
    "db:seed": "npm run seed -w @ntrack/db",
    "analytics:migrate": "npm run migrate -w @ntrack/analytics",
    "local:db": "node scripts/local-postgres.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "embedded-postgres": "^17.10.0-beta.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
